# The sdist should carry everything needed to verify the project, not just to
# import it: a source distribution that cannot be tested is not much of a source
# distribution.
include LICENSE
include CHANGELOG.md
include README.md
include mkdocs.yml
include pyproject.toml

recursive-include tests *.py
recursive-include examples *.py
recursive-include benchmarks *.py
recursive-include docs *.md
recursive-include scripts *.py
include src/odesuite/py.typed

# Generated: figures are regenerated by benchmarks/run_all.py, and the docs home
# page and figures are staged from the repository root at build time.
prune site
prune docs/figures
exclude docs/index.md
exclude docs/license.md
global-exclude *.py[cod] __pycache__/*
